<Window
    x:Class="Kipo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Kipo.Core"
    Title="Kipo">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <TitleBar x:Name="AppTitleBar"
                  Title="Kipo">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Content -->
        <Grid x:Name="Root"
              Grid.Row="1"
              Padding="16,0,16,8"
              AllowDrop="True"
              Background="Transparent"
              DragOver="OnDragOver"
              Drop="OnDrop">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="DropRow"
                               Height="*" />
                <RowDefinition x:Name="QueueRow"
                               Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="V"
                                     Modifiers="Control"
                                     Invoked="OnPasteInvoked" />
            </Grid.KeyboardAccelerators>

            <!-- Drop Section -->
            <Grid Grid.Row="0"
                  Height="280"
                  VerticalAlignment="Center">
                <Grid x:Name="DropZone"
                      Height="140"
                      VerticalAlignment="Center"
                      AutomationProperties.AutomationId="DropZone"
                      AutomationProperties.Name="Drop zone">
                    <Rectangle RadiusX="8"
                               RadiusY="8"
                               Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                               StrokeThickness="1.5"
                               StrokeDashArray="4 3"
                               Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <TextBlock Text="Drop, paste (Ctrl+V), or browse"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button x:Name="BrowseButton"
                                HorizontalAlignment="Center"
                                Content="Browse"
                                AutomationProperties.AutomationId="BrowseButton"
                                Click="OnBrowseClick" />
                    </StackPanel>
                </Grid>
            </Grid>
            <!-- /Drop Section -->

            <!-- Queue -->
            <ListView x:Name="QueueList"
                      Grid.Row="1"
                      SelectionMode="None"
                      Visibility="Collapsed"
                      AutomationProperties.AutomationId="QueueList"
                      AutomationProperties.Name="Queue">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:QueueItem">
                        <Grid ColumnSpacing="8"
                              Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind FileName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Visibility="{x:Bind CanCancel, Mode=OneWay}"
                                    AutomationProperties.Name="Cancel"
                                    ToolTipService.ToolTip="Cancel"
                                    Click="OnCancelItemClick">
                                <FontIcon Glyph="&#xE711;"
                                          FontSize="12" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <!-- /Queue -->

            <!-- Cancel All -->
            <HyperlinkButton x:Name="CancelAllLink"
                             Grid.Row="2"
                             HorizontalAlignment="Right"
                             Content="Cancel all"
                             Visibility="Collapsed"
                             AutomationProperties.AutomationId="CancelAllLink"
                             Click="OnCancelAllClick" />
        </Grid>
        <!-- /Content -->

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="16,10"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Target Size -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <TextBlock Text="Target size"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="SizeCombo"
                              MinWidth="110"
                              AutomationProperties.AutomationId="SizeCombo"
                              AutomationProperties.Name="Target size"
                              SelectionChanged="OnSizeChanged" />
                    <NumberBox x:Name="CustomSizeBox"
                               Width="110"
                               Minimum="1"
                               Maximum="10000"
                               PlaceholderText="MB"
                               SpinButtonPlacementMode="Compact"
                               Visibility="Collapsed"
                               AutomationProperties.AutomationId="CustomSizeBox"
                               AutomationProperties.Name="Custom size in MB"
                               ValueChanged="OnCustomSizeChanged" />
                </StackPanel>

                <!-- Settings: icon only, no background or hover -->
                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Padding="6"
                        VerticalAlignment="Center"
                        UseSystemFocusVisuals="True"
                        AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="Settings"
                        ToolTipService.ToolTip="Settings">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter Padding="{TemplateBinding Padding}"
                                              Background="Transparent"
                                              Content="{TemplateBinding Content}" />
                        </ControlTemplate>
                    </Button.Template>
                    <FontIcon Glyph="&#xE713;"
                              FontSize="16" />
                    <Button.Flyout>
                        <Flyout>
                            <ToggleSwitch x:Name="CopyToClipboardToggle"
                                          Header="Copy result to clipboard (single file)"
                                          AutomationProperties.AutomationId="CopyToClipboardToggle"
                                          Toggled="OnCopyToggled" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
        <!-- /Footer -->
    </Grid>
</Window>
