<Window
    x:Class="Kipo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Kipo.Core"
    xmlns:local="using:Kipo"
    Title="Kipo Video Compressor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <TitleBar x:Name="AppTitleBar"
                  Title="Kipo Video Compressor">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.png" />
            </TitleBar.IconSource>
            <TitleBar.LeftHeader>
                <!-- Slot opens from 0 to 32px; the arrow sits 8px in (same as its top gap) and
                     overlaps the slot's end so the app icon lands 8px after it -->
                <Canvas x:Name="BackSlot"
                        Width="0"
                        Height="32"
                        VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Canvas.Left="8"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Opacity="0"
                            Visibility="Collapsed"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.AutomationId="BackButton"
                            AutomationProperties.Name="Back"
                            ToolTipService.ToolTip="Back"
                            Click="OnBackClick">
                        <FontIcon Glyph="&#xE72B;"
                                  FontSize="12" />
                    </Button>
                </Canvas>
            </TitleBar.LeftHeader>
        </TitleBar>

        <!-- Main View -->
        <Grid x:Name="MainView"
              Grid.Row="1"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Content -->
            <Grid x:Name="Root"
                  Grid.Row="0"
                  Padding="16,0,16,8"
                  AllowDrop="True"
                  Background="Transparent"
                  KeyboardAcceleratorPlacementMode="Hidden"
                  DragOver="OnDragOver"
                  Drop="OnDrop"
                  SizeChanged="OnRootSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.KeyboardAccelerators>
                    <KeyboardAccelerator Key="V"
                                         Modifiers="Control"
                                         Invoked="OnPasteInvoked" />
                </Grid.KeyboardAccelerators>

                <!-- Drop Section -->
                <Grid Grid.Row="0"
                      Height="280">
                    <Grid x:Name="DropZone"
                          Height="240"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="DropZone"
                          AutomationProperties.Name="Drop zone">
                        <Rectangle RadiusX="8"
                                   RadiusY="8"
                                   Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="4 3"
                                   Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <TextBlock Text="Select a video to compress"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Drag and drop, paste, or browse for a video"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="BrowseButton"
                                    HorizontalAlignment="Center"
                                    Content="Browse"
                                    AutomationProperties.AutomationId="BrowseButton"
                                    Click="OnBrowseClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <!-- /Drop Section -->

                <!-- File List -->
                <local:QueueView x:Name="QueueView"
                                 Grid.Row="1" />
            </Grid>
            <!-- /Content -->

            <!-- Copied Alert -->
            <InfoBar x:Name="CopiedBar"
                     Grid.Row="1"
                     Margin="16,0,16,8"
                     Severity="Success"
                     Title="Copied to clipboard"
                     IsOpen="False" />

            <!-- Footer -->
            <Border x:Name="Footer"
                    Grid.Row="2"
                    Padding="16,10"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Target Size -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock Text="Target size"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="SizeCombo"
                                  MinWidth="110"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="SizeCombo"
                                  AutomationProperties.Name="Target size"
                                  SelectionChanged="OnSizeChanged" />
                        <NumberBox x:Name="CustomSizeBox"
                                   Width="110"
                                   Height="31"
                                   VerticalAlignment="Center"
                                   Minimum="1"
                                   Maximum="10000"
                                   PlaceholderText="MB"
                                   SpinButtonPlacementMode="Compact"
                                   Visibility="Collapsed"
                                   AutomationProperties.AutomationId="CustomSizeBox"
                                   AutomationProperties.Name="Custom size in MB"
                                   ValueChanged="OnCustomSizeChanged">
                            <!-- One pixel shorter so its underline doesn't make it look taller than the dropdown -->
                            <NumberBox.Resources>
                                <x:Double x:Key="TextControlThemeMinHeight">31</x:Double>
                            </NumberBox.Resources>
                        </NumberBox>
                    </StackPanel>

                    <!-- Settings: icon only, no background or hover -->
                    <Button x:Name="SettingsButton"
                            Grid.Column="1"
                            Padding="6"
                            VerticalAlignment="Center"
                            UseSystemFocusVisuals="True"
                            AutomationProperties.AutomationId="SettingsButton"
                            AutomationProperties.Name="Settings"
                            ToolTipService.ToolTip="Settings"
                            Click="OnSettingsClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter Padding="{TemplateBinding Padding}"
                                                  Background="Transparent"
                                                  Content="{TemplateBinding Content}" />
                            </ControlTemplate>
                        </Button.Template>
                        <FontIcon Glyph="&#xE713;"
                                  FontSize="16" />
                    </Button>
                </Grid>
            </Border>
            <!-- /Footer -->
        </Grid>
        <!-- /Main View -->

        <!-- Settings View -->
        <ScrollViewer x:Name="SettingsView"
                      Grid.Row="1"
                      RenderTransformOrigin="0.5,0.5"
                      Visibility="Collapsed"
                      AutomationProperties.AutomationId="SettingsView"
                      AutomationProperties.Name="Settings">
            <ScrollViewer.RenderTransform>
                <ScaleTransform />
            </ScrollViewer.RenderTransform>
            <StackPanel Padding="16,16,16,16"
                        Spacing="12">
                <TextBlock x:Name="SettingsHeader"
                           Text="Settings"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           AutomationProperties.AutomationId="SettingsHeader" />
                <!-- Clipboard Setting Card -->
                <Grid x:Name="CopyToClipboardCard"
                      MinHeight="68"
                      Padding="16,8"
                      ColumnSpacing="16"
                      CornerRadius="{ThemeResource OverlayCornerRadius}"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8C8;"
                              FontSize="20"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="Copy result to clipboard"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Only works for single file selection."
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="CopyToClipboardState"
                               Grid.Column="2"
                               VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="CopyToClipboardToggle"
                                  Grid.Column="3"
                                  MinWidth="0"
                                  OnContent=""
                                  OffContent=""
                                  VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="CopyToClipboardToggle"
                                  AutomationProperties.Name="Copy result to clipboard"
                                  Toggled="OnCopyToggled" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <!-- /Settings View -->
    </Grid>
</Window>
