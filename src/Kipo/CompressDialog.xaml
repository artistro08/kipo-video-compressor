<Window
    x:Class="Kipo.CompressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kipo"
    Title="Kipo Video Compressor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <TitleBar x:Name="AppTitleBar"
                  Title="Kipo Video Compressor">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Square44x44Logo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Content -->
        <Grid Grid.Row="1"
              Padding="16,4,16,12">

            <!-- Custom Size Form -->
            <StackPanel x:Name="CustomForm"
                        Spacing="12"
                        Visibility="Collapsed"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform />
                </StackPanel.RenderTransform>
                <TextBlock Text="Target size"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <NumberBox x:Name="CustomDialogSizeBox"
                               Width="140"
                               Minimum="1"
                               Maximum="10000"
                               PlaceholderText="MB"
                               SpinButtonPlacementMode="Compact"
                               AutomationProperties.AutomationId="CustomDialogSizeBox"
                               AutomationProperties.Name="Target size in MB" />
                    <TextBlock Text="MB"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="CustomDialogCompressButton"
                        Content="Compress"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="CustomDialogCompressButton"
                        Click="OnCompressClick" />
            </StackPanel>
            <!-- /Custom Size Form -->

            <!-- File List -->
            <local:QueueView x:Name="QueueView"
                             RenderTransformOrigin="0.5,0.5">
                <local:QueueView.RenderTransform>
                    <ScaleTransform />
                </local:QueueView.RenderTransform>
            </local:QueueView>
        </Grid>
        <!-- /Content -->

        <!-- Copied Alert -->
        <InfoBar x:Name="CopiedBar"
                 Grid.Row="2"
                 Margin="16,0,16,12"
                 Severity="Success"
                 Title="Copied to clipboard"
                 IsOpen="False" />
    </Grid>
</Window>
